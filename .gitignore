# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Env / secrets ───────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample

# ── Build / TS / Next outputs ───────────────────────────────────────────────
dist/
build/
out/
coverage/
*.tsbuildinfo
frontend/.next/
frontend/next-env.d.ts

# ── Prisma generated client (regenerated on install) ────────────────────────
backend/src/generated/
backend/prisma/generated/

# ── Backend local uploads (Cloudinary is the source of truth) ───────────────
backend/uploads/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ── Editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Claude / per-machine settings ───────────────────────────────────────────
.claude/settings.local.json

# ── Graphify cache (rebuildable) ────────────────────────────────────────────
graphify-out/cache/
