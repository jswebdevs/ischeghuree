# Ische Ghuree frontend — environment variables
# Copy to .env and fill in the values for your environment.

# Backend API base URL (must include the /api/v1 prefix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public storefront origin. Used by:
#   - app/robots.ts        (sitemap reference + host)
#   - app/sitemap.ts       (absolute URLs in the XML)
#   - app/layout.tsx       (metadataBase + Organization JSON-LD url/logo)
NEXT_PUBLIC_CLIENT_URL=http://localhost:5173

# Production reference:
# NEXT_PUBLIC_API_URL=https://ischeghuree-backend.vercel.app/api/v1
# NEXT_PUBLIC_CLIENT_URL=https://ischeghuree.com
