# ──────────────────────────────────────────────────────────────────────────
# Ische Ghuree backend — environment template
# Copy to .env and fill in real values. NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────
PORT=4000
# "production" enables strict CORS (no automatic localhost allowlist).
NODE_ENV=development

# ── Frontend / CORS ────────────────────────────────────────────────────────
# Primary public storefront URL (also accepted as a single CORS origin).
CLIENT_URL=http://localhost:5173

# Optional single extra origin (honored by both REST and socket.io CORS).
# CORS_ORIGIN=https://ischeghuree.com

# Comma-separated exact origins. Used for Express + socket.io CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated case-insensitive regex sources for dynamic origins
# (Vercel deploys/previews of the ischeghuree frontend, custom domain).
CORS_ALLOWED_ORIGIN_PATTERNS=^https://ischeghuree(-[a-z0-9-]+)?\.vercel\.app$,^https://[a-z0-9-]+--ischeghuree\.vercel\.app$,^https://([a-z0-9-]+\.)?ischeghuree\.com$

# Set to 1 to accept any origin (debug only — never leave on in production).
# CORS_ALLOW_ALL=1

# ── Rate limiting (optional; defaults shown) ───────────────────────────────
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=200
# WRITE_RATE_LIMIT_WINDOW_MS=60000
# WRITE_RATE_LIMIT_MAX=30

# ── Auth ───────────────────────────────────────────────────────────────────
# Long random hex string, e.g. `openssl rand -hex 64`.
JWT_SECRET=replace-with-a-long-random-secret
# Token lifetime (jsonwebtoken format). Defaults to 30d when unset.
JWT_EXPIRES_IN=30d

# ── Email (Gmail SMTP via nodemailer) ──────────────────────────────────────
# GMAIL_APP_PASSWORD is a Google "app password", not the account password.
GMAIL_USER=your-store@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true"
# Direct connection used for migrations / db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Cloudinary (media storage) ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Google Places (Google Reviews fallback if SiteSettings is empty) ───────
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=

# ── BulkSMSBD (phone OTP SMS) ──────────────────────────────────────────────
# Optional — OTP endpoint degrades gracefully without these.
# BULKSMSBD_API_KEY=
# BULKSMSBD_SENDER_ID=
